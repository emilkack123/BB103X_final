FASTA_FILE = "resources/dragon_radii_updated.fasta"
PI_CSV = "pI_results.csv"
HYDROPHOBICITY_CSV = "hydrophobicity_results.csv"
RANKED_CSV = "ranked_sequences.csv"


rule all:
    input:
        RANKED_CSV

rule compute_pI:
    input:
        FASTA_FILE
    output:
        PI_CSV
    shell:
        "python workflow/calculate_pI.py -i {input} -o {output}"

rule compute_hydrophobicity:
    input:
        FASTA_FILE
    output:
        HYDROPHOBICITY_CSV
    shell:
        "python workflow/compute_hydrophobicity.py -i {input} -o {output}"

    
rule rank_sequences:
    input:
        pI=PI_CSV,
        hydrophobicity=HYDROPHOBICITY_CSV
    output:
        RANKED_CSV
    shell:
        "python workflow/ranking_matrix.py --pI {input.pI} --hydrophobicity {input.hydrophobicity} -o {output}"